class Funcionario:
    '''Define nome setor e cargo do funcionario
    na respectiva ordem funcionario(nome,setor,cargo)'''
    def __init__(self, n, s , c):
        self.nome= n
        self.setor= s
        self.cargo= c
    #metodo
    def __str__(self):
        return f'Olá! Me chamo {self.nome} e sou {self.cargo} no setor de {self.setor} da empresa Curso em Vídeo. '
f1=Funcionario('Maria','Administrativo','Diretora')
f2=Funcionario('Camilla','TI','Programadora')
print (f1)
